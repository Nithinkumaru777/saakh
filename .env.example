# ---- Saakh production configuration -------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.

# API ------------------------------------------------------------------------------
SAAKH_ENV=production
# Long random string. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# The API refuses to start in production without it. Changing it signs every user out.
SAAKH_SECRET_KEY=
# Public URL(s) of the website, comma separated (CORS allow-list)
SAAKH_CORS_ORIGINS=https://saakh.example.com
# SQLite file on a persistent volume
SAAKH_DB_PATH=/data/saakh.db
# Session lifetime in hours (default 168 = 7 days)
SAAKH_TOKEN_TTL_H=168

# Web ------------------------------------------------------------------------------
# Public URL of the API. Baked into the web build, so set it BEFORE `pnpm build`.
NEXT_PUBLIC_API_URL=https://api.saakh.example.com
# Public address of the website, used for the social preview image. Also baked in at build time.
NEXT_PUBLIC_SITE_URL=https://saakh.example.com
